{
  "name": "pt-plugin-plus-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local MCP bridge for PT-Plugin-Plus. It is independent from Codex browser plugins.",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node --env-file-if-exists=.env ./node_modules/tsx/dist/cli.mjs src/main.ts",
    "start:detached": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-bridge.ps1",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/ai.ts && tsx tests/bridge.ts && tsx tests/mcp.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
