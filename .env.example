# Copy this file to .env and replace the placeholder values with your own settings.
PTPP_MCP_BRIDGE_TOKEN=replace-with-a-local-random-token
PTPP_MCP_BRIDGE_PORT=19799
PTPP_MCP_AI_ENDPOINT=https://your-openai-compatible-provider.example/v1
PTPP_MCP_AI_MODEL=your-model-name
PTPP_MCP_AI_API_KEY=replace-with-your-local-api-key
# Optional; leave unset to use the service default.
# PTPP_MCP_AI_TIMEOUT_MS=60000
